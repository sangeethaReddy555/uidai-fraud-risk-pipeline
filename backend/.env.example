# Copy to .env.  DEVELOPMENT VALUES ONLY - nothing here is a production credential.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./risk_pipeline.db
# DATABASE_URL=postgresql+psycopg2://risk:risk@localhost:5432/risk

# MUST be replaced (>=32 random chars) for any non-development environment.
JWT_SECRET=dev-only-secret-NOT-for-production-use-0123456789
JWT_ISSUER=uidai-sandbox-dev
JWT_AUDIENCE=risk-score-api
ENABLE_DEV_TOKENS=true

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_INITIATE_PER_MINUTE=30
RATE_LIMIT_READ_PER_MINUTE=120

# mock = in-process queue (no Kafka needed). real = Kafka cluster (see docker-compose.yml).
KAFKA_MODE=mock
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=Risk_Evaluation_Requested
EMBEDDED_WORKER=true

CALLBACK_MAX_RETRIES=5
CALLBACK_BACKOFF_BASE_SECONDS=2
CALLBACK_BACKOFF_MAX_SECONDS=300

# Development only: lets the local demo callback sink (http://localhost:8000/api/v1/dev/callback-sink) work.
# The app refuses to start with these enabled when ENVIRONMENT != development.
ALLOW_HTTP_CALLBACKS=true
ALLOW_PRIVATE_CALLBACKS=true
SSRF_DNS_CHECK=true
